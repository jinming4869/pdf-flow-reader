{
  "name": "pdf-flow-reader",
  "version": "2.2.1",
  "private": false,
  "description": "A calm, local-only PDF auto-scroll reader.",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "app:start": "electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder"
  },
  "license": "MIT",
  "author": "jinming4869",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jinming4869.pdf-flow-reader",
    "productName": "夜晚的书斋",
    "asar": false,
    "files": [
      "electron-main.mjs",
      "server.mjs",
      "app.mjs",
      "index.html",
      "styles.css",
      "http-range.mjs",
      "ocr-provider.mjs",
      "page-layout.mjs",
      "pdf-source.mjs",
      "reading-model.mjs",
      "render-scheduler.mjs",
      "vendor/**/*",
      "build/**/*",
      "!build/*-source.jpg",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "night-study-${version}-mac-${arch}.${ext}",
      "target": [
        "dir",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "night-study-${version}-windows-portable.${ext}"
    }
  }
}
