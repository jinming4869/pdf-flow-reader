{
  "name": "pdf-flow-reader",
  "version": "3.0.0",
  "private": false,
  "description": "A calm, local-only PDF auto-scroll reader.",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:tts-multilingual:smoke": "node scripts/tts-multilingual-smoke.mjs",
    "app:start": "electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder"
  },
  "license": "MIT",
  "author": "jinming4869",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jinming4869.pdf-flow-reader",
    "productName": "夜晚的书斋",
    "asar": false,
    "files": [
      "electron-main.mjs",
      "server.mjs",
      "app.mjs",
      "index.html",
      "styles.css",
      "http-range.mjs",
      "chunk-coordinate.mjs",
      "ocr-provider.mjs",
      "ocr-schedule.mjs",
      "ocr-segment-adapter.mjs",
      "page-layout.mjs",
      "pdf-source.mjs",
      "reading-model.mjs",
      "reading-rhythm.mjs",
      "reading-clock.mjs",
      "readable-chunk.mjs",
      "render-scheduler.mjs",
      "sound-engine.mjs",
      "storage.mjs",
      "text-cleaner.mjs",
      "text-segment.mjs",
      "text-source-state.mjs",
      "tts-audio-player.mjs",
      "tts-aesthetic-walk.mjs",
      "tts-controller.mjs",
      "tts-model-manager.mjs",
      "tts-paragraph-flow.mjs",
      "tts-policy.mjs",
      "tts-point-gesture.mjs",
      "tts-point-sentence.mjs",
      "tts-point-session.mjs",
      "tts-preferences.mjs",
      "tts-provider.mjs",
      "tts-multilingual-runtime-client.mjs",
      "tts-runtime-client.mjs",
      "tts-runtime-router.mjs",
      "tts-scheduler.mjs",
      "tts-sentence.mjs",
      "tts-segment-picker.mjs",
      "tts-worker.mjs",
      "tts_multilingual_worker.py",
      "scripts/proxy-bootstrap.mjs",
      "scripts/tts-multilingual-smoke.mjs",
      "docs/**/*",
      "vendor/**/*",
      "build/**/*",
      "!build/*-source.jpg",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "night-study-${version}-mac-${arch}.${ext}",
      "target": [
        "dir",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "night-study-${version}-windows-portable.${ext}"
    }
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "undici": "^8.9.0"
  }
}
